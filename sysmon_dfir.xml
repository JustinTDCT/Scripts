        <TargetObject condition="contains" name="DefenderExclusions">\Windows Defender\Exclusions</TargetObject>
        <TargetObject condition="contains" name="EventLogPolicy">\Policies\Microsoft\Windows\EventLog</TargetObject>
        <TargetObject condition="contains" name="AccessibilitySettings">\Accessibility</TargetObject>
        <TargetObject condition="contains" name="LSASettings">\CurrentControlSet\Control\Lsa\</TargetObject>
        <TargetObject condition="contains" name="SecurityProviders">\CurrentControlSet\Control\SecurityProviders\</TargetObject>
        <TargetObject condition="contains" name="SafeBoot">\CurrentControlSet\Control\SafeBoot\</TargetObject>
        <TargetObject condition="contains" name="WMISettings">\SOFTWARE\Microsoft\Wbem\CIMOM</TargetObject>
        <TargetObject condition="contains" name="PowerShellSettings">\Microsoft\PowerShell\</TargetObject>
        <TargetObject condition="contains" name="PowerShellPolicy">\Policies\Microsoft\Windows\PowerShell\</TargetObject>
        <TargetObject condition="contains" name="RDPPolicy">\Policies\Microsoft\Windows NT\Terminal Services\</TargetObject>
        <TargetObject condition="contains" name="FirewallPolicy">\Services\SharedAccess\Parameters\FirewallPolicy\</TargetObject>
        <Rule name="Service_Objects_CreateDeleteRename" groupRelation="and">
