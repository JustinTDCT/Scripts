<Sysmon schemaversion="4.90">
  <!-- 
SYSMON DFIR LOGGING BASELINE
Version: 2026.09.06-passive.2
Based on the supplied 2026.03.23 configuration; revised for lower-volume DFIR.

NONBLOCKING REQUIREMENT
  FileBlockExecutable (27) and FileBlockShredding (28) are explicitly DISABLED.
  FileDelete archiving (23) and clipboard capture (24) are OFF.
  Legacy CopyOnDelete globals are omitted for current Sysmon compatibility.
  No copy-on-delete SID, extension or process selectors are configured.
  Event 26 records selected deletions; it does not preserve deleted files.
  Event 29 records executable creation; it does not block executable writes.
  Do not add blocking rules or change the empty includes for IDs 23, 24, 27, 28.

COLLECTION CHANGES
  Fixed the Event 11 drive-colon catch-all; ADS evidence uses Event 15.
  Kept broad process creation; only paired Windows Search helpers are excluded.
  Removed parent-only ngen and blanket conhost/Sysmon process exclusions.
  Disabled process termination (5) and DLL/image loading (7) for this baseline.
  Restricted process access (10) to LSASS; removed global access-mask matches.
  Targeted file creation, timestamps and deletion; no entire Temp tree capture.
  Narrowed Office, service, COM, session and network registry collection.
  Narrowed named pipes; removed all-user-profile and generic RPC catch-alls.
  Removed svchost exclusions from thread creation, raw reads and PE creation.
  Removed broad Microsoft/CDN DNS exclusions and retained network attribution.
  Changed hashing to SHA256; reverse DNS and revocation lookups remain off.

TRADEOFFS AND TUNING
  This is telemetry, not a malicious/benign verdict or a complete EDR replacement.
  IDs 5 and 7 are off: exact process end times and per-module load history are lost.
  File, registry and pipe includes deliberately omit activity outside their scope.
  Scoped service-writer exclusions omit some legitimate servicing activity and
  could also hide misuse that meets exactly the same writer and destination rule.
  Network/DNS and IDs 8/9 retain useful visibility. Some restored categories may
  increase in volume. No destination, management-agent or backup-agent allowlist
  has been invented without event samples from this environment.
  Exclusion rules must identify a narrow behavior with explicit AND conditions.
  Do not exclude all RMM children, browsers, HTTPS, internal IPs or cloud domains.
  Low event volume does not guarantee zero CPU, memory, driver or disk overhead.
  Compare workload responsiveness and event volume over 48 to 72 hours, including
  software updates and backups. Configure bounded local log retention separately.
  Disabling archiving does not remove copies already saved by the old config.
  Protect access to logs: command lines and named streams can contain sensitive data.

APPLY TO AN EXISTING INSTALLATION (elevated terminal; use the actual binary path)
  sysmon64.exe -c sysmon-dfir-passive.xml
  sysmon64.exe -c
  The first command applies this file; the second displays the loaded settings.
  Keep the previous production configuration available before changing it.
  Schema 4.90 is retained from the source. Schema and executable versions differ.
  Check the installed build with sysmon64.exe -s; do not bypass a schema error.
  Validated against the embedded 4.90 and 4.91 DTDs from Sysmon 15.21.
  This file has not been executed by Sysmon on a Windows host in this review.

REFERENCES (event semantics and rule syntax; the collection choices are local)
  https://learn.microsoft.com/en-us/sysinternals/downloads/sysmon
  https://github.com/trustedsec/SysmonCommunityGuide/blob/master/chapters/file-create.md
 -->
  <!-- SHA256 only. Add another hash only when the investigation workflow needs it. -->
  <HashAlgorithms>SHA256</HashAlgorithms>
  <!-- Controls signature revocation lookups; false sacrifices revocation enrichment. -->
  <CheckRevocation>false</CheckRevocation>
  <!-- Disables reverse DNS enrichment, not Event 22 DNS-query logging. -->
  <DnsLookup>false</DnsLookup>
  <!-- Archiving is disabled by the empty FileDelete include below. Omit obsolete CopyOnDelete globals. -->
  <EventFiltering>
    <!-- ID 1: Broad process/parent/command-line history. No RMM-parent exclusions. -->
    <RuleGroup name="ProcessCreate_exclude" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <Rule name="WindowsSearch_SearchProtocolHost" groupRelation="and">
          <Image condition="is">C:\Windows\System32\SearchProtocolHost.exe</Image>
          <ParentImage condition="is">C:\Windows\System32\SearchIndexer.exe</ParentImage>
        </Rule>
        <Rule name="WindowsSearch_SearchFilterHost" groupRelation="and">
          <Image condition="is">C:\Windows\System32\SearchFilterHost.exe</Image>
          <ParentImage condition="is">C:\Windows\System32\SearchIndexer.exe</ParentImage>
        </Rule>
        <!-- Only these exact child/parent pairs are omitted; other children of SearchIndexer remain visible. -->
      </ProcessCreate>
    </RuleGroup>
    <!-- ID 2: Timestamp changes on selected payloads and persistence files. -->
    <RuleGroup name="FileCreateTime_include" groupRelation="or">
      <FileCreateTime onmatch="include">
        <TargetFilename condition="contains" name="StartupArtifact">\Start Menu\Programs\Startup\</TargetFilename>
        <TargetFilename condition="contains" name="ScheduledTaskArtifact">\Windows\System32\Tasks\</TargetFilename>
        <TargetFilename condition="contains" name="LegacyTaskArtifact">\Windows\Tasks\</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.exe</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.sys</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.scr</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.ps1</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.psm1</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.bat</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.cmd</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.vbs</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.vbe</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.jse</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.wsf</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.wsh</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.hta</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.cpl</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.msi</TargetFilename>
        <TargetFilename condition="end with" name="Timestamp_Artifact">.reg</TargetFilename>
        <Rule name="Timestamp_Staged_dll" groupRelation="and">
          <TargetFilename condition="end with">.dll</TargetFilename>
          <TargetFilename condition="contains any">\Downloads\;\Desktop\;\Temp\;\PerfLogs\;\Users\Public\</TargetFilename>
        </Rule>
        <Rule name="Timestamp_Staged_js" groupRelation="and">
          <TargetFilename condition="end with">.js</TargetFilename>
          <TargetFilename condition="contains any">\Downloads\;\Desktop\;\Temp\;\PerfLogs\;\Users\Public\</TargetFilename>
        </Rule>
        <Rule name="Timestamp_Staged_lnk" groupRelation="and">
          <TargetFilename condition="end with">.lnk</TargetFilename>
          <TargetFilename condition="contains any">\Downloads\;\Desktop\;\Temp\;\PerfLogs\;\Users\Public\</TargetFilename>
        </Rule>
        <Rule name="Timestamp_Staged_psd1" groupRelation="and">
          <TargetFilename condition="end with">.psd1</TargetFilename>
          <TargetFilename condition="contains any">\Downloads\;\Desktop\;\Temp\;\PerfLogs\;\Users\Public\</TargetFilename>
        </Rule>
      </FileCreateTime>
    </RuleGroup>
    <!-- Bounded Windows servicing exclusions: both writer and destination must match. -->
    <RuleGroup name="FileCreateTime_exclude" groupRelation="or">
      <FileCreateTime onmatch="exclude">
        <Rule name="TrustedInstaller_WinSxS" groupRelation="and">
          <Image condition="is">C:\Windows\servicing\TrustedInstaller.exe</Image>
          <TargetFilename condition="begin with">C:\Windows\WinSxS\</TargetFilename>
        </Rule>
        <Rule name="TiWorker_WinSxS" groupRelation="and">
          <Image condition="begin with">C:\Windows\WinSxS\</Image>
          <Image condition="end with">\TiWorker.exe</Image>
          <TargetFilename condition="begin with">C:\Windows\WinSxS\</TargetFilename>
        </Rule>
        <Rule name="TrustedInstaller_SoftwareDistribution" groupRelation="and">
          <Image condition="is">C:\Windows\servicing\TrustedInstaller.exe</Image>
          <TargetFilename condition="begin with">C:\Windows\SoftwareDistribution\</TargetFilename>
        </Rule>
        <Rule name="TiWorker_SoftwareDistribution" groupRelation="and">
          <Image condition="begin with">C:\Windows\WinSxS\</Image>
          <Image condition="end with">\TiWorker.exe</Image>
          <TargetFilename condition="begin with">C:\Windows\SoftwareDistribution\</TargetFilename>
        </Rule>
      </FileCreateTime>
    </RuleGroup>
    <!-- ID 3: TCP/UDP connection records with process attribution. Log all; tune from measured samples. -->
    <RuleGroup name="NetworkConnect_exclude" groupRelation="or">
      <NetworkConnect onmatch="exclude" />
    </RuleGroup>
    <!-- ID 5: Process termination is omitted to reduce per-process records. Empty include matches nothing: disabled. -->
    <RuleGroup name="ProcessTerminate_include" groupRelation="or">
      <ProcessTerminate onmatch="include" />
    </RuleGroup>
    <!-- ID 6: Log all driver loads, including signed drivers; signatures alone are not a trust decision. -->
    <RuleGroup name="DriverLoad_exclude" groupRelation="or">
      <DriverLoad onmatch="exclude" />
    </RuleGroup>
    <!-- ID 7: DLL/image-load collection is off for the lightweight baseline. Empty include matches nothing: disabled. -->
    <RuleGroup name="ImageLoad_include" groupRelation="or">
      <ImageLoad onmatch="include" />
    </RuleGroup>
    <!-- ID 8: Log all remote-thread creation. No source-only exemptions for system or debugger processes. -->
    <RuleGroup name="CreateRemoteThread_exclude" groupRelation="or">
      <CreateRemoteThread onmatch="exclude" />
    </RuleGroup>
    <!-- ID 9: Raw disk-read records. No svchost, VDS or blanket backup-agent exclusion. -->
    <RuleGroup name="RawAccessRead_exclude" groupRelation="or">
      <RawAccessRead onmatch="exclude">
        <Rule name="Defender_PlatformEngine_RawReads" groupRelation="and">
          <Image condition="begin with">C:\ProgramData\Microsoft\Windows Defender\Platform\</Image>
          <Image condition="end with">\MsMpEng.exe</Image>
        </Rule>
        <!-- Retains a narrower version of the original Defender scan exclusion; applies only to this engine path. -->
      </RawAccessRead>
    </RuleGroup>
    <!-- ID 10: LSASS access only. Access rights are event evidence, not independent global include rules. -->
    <RuleGroup name="ProcessAccess_include" groupRelation="or">
      <ProcessAccess onmatch="include">
        <TargetImage condition="end with" name="LSASS_Access">\Windows\System32\lsass.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>
    <!-- ID 11: Selected file creation/overwrite evidence. No drive-colon or whole-Temp-tree match. -->
    <RuleGroup name="FileCreate_include" groupRelation="or">
      <FileCreate onmatch="include">
        <TargetFilename condition="contains" name="StartupArtifact">\Start Menu\Programs\Startup\</TargetFilename>
        <TargetFilename condition="contains" name="ScheduledTaskArtifact">\Windows\System32\Tasks\</TargetFilename>
        <TargetFilename condition="contains" name="LegacyTaskArtifact">\Windows\Tasks\</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.exe</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.sys</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.scr</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.ps1</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.psm1</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.bat</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.cmd</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.vbs</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.vbe</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.jse</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.wsf</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.wsh</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.hta</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.cpl</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.msi</TargetFilename>
        <TargetFilename condition="end with" name="Create_Artifact">.reg</TargetFilename>
        <Rule name="Create_Staged_dll" groupRelation="and">
          <TargetFilename condition="end with">.dll</TargetFilename>
          <TargetFilename condition="contains any">\Downloads\;\Desktop\;\Temp\;\PerfLogs\;\Users\Public\</TargetFilename>
        </Rule>
        <Rule name="Create_Staged_js" groupRelation="and">
          <TargetFilename condition="end with">.js</TargetFilename>
          <TargetFilename condition="contains any">\Downloads\;\Desktop\;\Temp\;\PerfLogs\;\Users\Public\</TargetFilename>
        </Rule>
        <Rule name="Create_Staged_lnk" groupRelation="and">
