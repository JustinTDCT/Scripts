    <RuleGroup name="FileCreateStreamHash_exclude" groupRelation="or">
      <FileCreateStreamHash onmatch="exclude" />
    </RuleGroup>
    <!-- IDs 17/18: Selected tool pipe names and scoped RPC use. Pipe names alone do not prove compromise. -->
    <RuleGroup name="PipeEvent_include" groupRelation="or">
      <PipeEvent onmatch="include">
        <PipeName condition="begin with" name="SelectedToolPipe">\MSSE-</PipeName>
        <PipeName condition="begin with" name="SelectedToolPipe">\postex_</PipeName>
        <PipeName condition="begin with" name="SelectedToolPipe">\msagent_</PipeName>
        <PipeName condition="begin with" name="SelectedToolPipe">\PSEXESVC</PipeName>
        <PipeName condition="begin with" name="SelectedToolPipe">\RemCom</PipeName>
        <PipeName condition="begin with" name="SelectedToolPipe">\DserNamePipe</PipeName>
        <Rule name="RPC_From_Staged_Process" groupRelation="and">
          <PipeName condition="is any">\svcctl;\wkssvc;\srvsvc;\atsvc;\epmapper;\samr;\lsarpc;\netlogon</PipeName>
          <Image condition="contains any">\Temp\;\Downloads\;\Users\Public\;\PerfLogs\</Image>
        </Rule>
        <!-- No all-profile pipe rule. Routine RPC from normal service locations and arbitrary custom pipe names are omitted. -->
      </PipeEvent>
    </RuleGroup>
    <!-- IDs 19/20/21: WMI subscription filter, consumer and binding changes; not all WMI operations. -->
    <RuleGroup name="WmiEvent_exclude" groupRelation="or">
      <WmiEvent onmatch="exclude" />
