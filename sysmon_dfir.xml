          <TargetFilename condition="end with">.pptm</TargetFilename>
          <TargetFilename condition="contains any">\Downloads\;\Desktop\;\Temp\;\PerfLogs\;\Users\Public\</TargetFilename>
        </Rule>
        <Rule name="Create_Staged_dotm" groupRelation="and">
          <TargetFilename condition="end with">.dotm</TargetFilename>
          <TargetFilename condition="contains any">\Downloads\;\Desktop\;\Temp\;\PerfLogs\;\Users\Public\</TargetFilename>
        </Rule>
        <Rule name="Create_Staged_xltm" groupRelation="and">
          <TargetFilename condition="end with">.xltm</TargetFilename>
          <TargetFilename condition="contains any">\Downloads\;\Desktop\;\Temp\;\PerfLogs\;\Users\Public\</TargetFilename>
        </Rule>
        <Rule name="Create_Staged_dmp" groupRelation="and">
          <TargetFilename condition="end with">.dmp</TargetFilename>
          <TargetFilename condition="contains any">\Downloads\;\Desktop\;\Temp\;\PerfLogs\;\Users\Public\</TargetFilename>
        </Rule>
        <Rule name="Create_Staged_mdmp" groupRelation="and">
          <TargetFilename condition="end with">.mdmp</TargetFilename>
          <TargetFilename condition="contains any">\Downloads\;\Desktop\;\Temp\;\PerfLogs\;\Users\Public\</TargetFilename>
