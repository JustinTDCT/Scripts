        <TargetFilename condition="contains" name="ScheduledTaskArtifact">\Windows\System32\Tasks\</TargetFilename>
        <TargetFilename condition="contains" name="LegacyTaskArtifact">\Windows\Tasks\</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.exe</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.sys</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.scr</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.ps1</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.psm1</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.bat</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.cmd</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.vbs</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.vbe</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.jse</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.wsf</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.wsh</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.hta</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.cpl</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.msi</TargetFilename>
        <TargetFilename condition="end with" name="Delete_Artifact">.reg</TargetFilename>
        <Rule name="Delete_Staged_dll" groupRelation="and">
          <TargetFilename condition="end with">.dll</TargetFilename>
          <TargetFilename condition="contains any">\Downloads\;\Desktop\;\Temp\;\PerfLogs\;\Users\Public\</TargetFilename>
        </Rule>
        <Rule name="Delete_Staged_js" groupRelation="and">
          <TargetFilename condition="end with">.js</TargetFilename>
          <TargetFilename condition="contains any">\Downloads\;\Desktop\;\Temp\;\PerfLogs\;\Users\Public\</TargetFilename>
        </Rule>
        <Rule name="Delete_Staged_lnk" groupRelation="and">
