    <!-- ID 27: EXECUTABLE FILE BLOCKING IS OFF. Do not add matching rules. Empty include matches nothing: disabled. -->
    <RuleGroup name="FileBlockExecutable_include" groupRelation="or">
      <FileBlockExecutable onmatch="include" />
    </RuleGroup>
    <!-- ID 28: FILE SHREDDING BLOCKING IS OFF. Do not add matching rules. Empty include matches nothing: disabled. -->
    <RuleGroup name="FileBlockShredding_include" groupRelation="or">
