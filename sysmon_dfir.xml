        <TargetFilename condition="end with" name="HostsFileChange">\Windows\System32\drivers\etc\hosts</TargetFilename>
        <!-- DLLs, JS, shortcuts, archives, disk images, macro documents and dumps require a staged path AND extension. -->
      </FileCreate>
    </RuleGroup>
    <!-- IDs 12/13/14: Selected persistence and security configuration changes. -->
    <RuleGroup name="RegistryEvent_include" groupRelation="or">
      <RegistryEvent onmatch="include">
        <TargetObject condition="contains" name="RunFamily">\CurrentVersion\Run</TargetObject>
        <TargetObject condition="contains" name="Winlogon">\Microsoft\Windows NT\CurrentVersion\Winlogon\</TargetObject>
        <TargetObject condition="contains" name="IFEO">\CurrentVersion\Image File Execution Options\</TargetObject>
        <TargetObject condition="contains" name="SilentProcessExit">\CurrentVersion\SilentProcessExit\</TargetObject>
        <TargetObject condition="contains" name="AppInitDLLs">\Microsoft\Windows NT\CurrentVersion\Windows\AppInit_DLLs</TargetObject>
